; Ledger X 演示账本 —— 所有数据均为虚构，用于体验 https://github.com/iskerwin/ledger-x
option "title" "Ledger X 演示账本"
option "operating_currency" "CNY"
option "booking_method" "FIFO"

include "config/commodities.bean"
include "config/subscriptions.bean"
include "config/budgets.bean"
include "config/events.bean"
include "accounts/accounts.bean"
include "accounts/balance.bean"
include "journals/2025.bean"
include "journals/2026.bean"
include "prices.bean"

; 账本里的查询会出现在 App「报表 → 账本中的查询」
2025-01-01 query "本月支出明细" "
  SELECT date, payee, narration, account, position
  WHERE account ~ '^Expenses:' AND year = YEAR(TODAY()) AND month = MONTH(TODAY())
  ORDER BY date DESC"

2025-01-01 query "各报销批次" "
  SELECT links, COUNT(*) AS n, SUM(position) AS total
  WHERE account = 'Assets:Receivable:Reimbursement' AND 'reimbursement' IN tags
  GROUP BY links
  ORDER BY links"
